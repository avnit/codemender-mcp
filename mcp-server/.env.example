# ============================================================================
# Code Mender MCP Server configuration
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `.env` is git-ignored, so secrets in it are never committed.
# - Local runs: config.py reads `.env` automatically.
# - Cloud Run: deploy_cloud_run.sh reads `.env` and passes the values to the
#   service. WIZ_CLIENT_SECRET is stored in Secret Manager, not as a plain
#   environment variable.
# ============================================================================

# --- Google Cloud ------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
REGION=us-central1
SERVICE_NAME=codemender-mcp-server

# --- BigQuery (Code Mender findings) ----------------------------------------
BQ_DATASET=codemender
BQ_TABLE=findings

# --- Cloud Logging ------------------------------------------------------------
LOG_NAME_FILTER=codemender

# --- Wiz ---------------------------------------------------------------------
# Create a Wiz service account (Settings > Service Accounts) with the
# `read:issues` permission. Leave these empty to run without Wiz.
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
# Your tenant's API endpoint (Wiz portal > User Settings > Tenant Info).
WIZ_API_ENDPOINT=https://api.us17.app.wiz.io/graphql
# Defaults; change only if your tenant uses a different auth endpoint.
WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
WIZ_AUDIENCE=wiz-api
# Secret Manager secret name used by deploy_cloud_run.sh for WIZ_CLIENT_SECRET.
WIZ_SECRET_NAME=wiz-client-secret

# --- Security data in BigQuery (read-only tools) -----------------------------
# Tables written by the log ingestion service.
SECURITY_DATASET=security_lab
SECURITY_EVENTS_TABLE=security_events
SANDBOX_RUNS_TABLE=sandbox_runs
CODE_TO_CLOUD_TABLE=code_to_cloud_map
# Security Command Center continuous export.
SCC_DATASET=scc_export
SCC_TABLE=findings
# Log sink destination. Table names are created by the sink from the log ID
# (confirm in your environment).
SECURITY_LOGS_DATASET=security_logs
MODEL_ARMOR_TABLE=modelarmor_googleapis_com_sanitize_operations
VPCSC_TABLE=cloudaudit_googleapis_com_policy

# --- Sandbox Cloud Run Job (start_sandbox_validation / get_sandbox_result) ---
SANDBOX_JOB_NAME=codemender-sandbox
# Empty = use REGION.
SANDBOX_REGION=
# Empty = <GCP_PROJECT_ID>-sandbox-inputs.
SANDBOX_BUCKET=

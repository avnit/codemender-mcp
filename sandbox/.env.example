# Copy to sandbox/.env and fill in. Never commit .env.
GCP_PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Artifact Registry repo and image
AR_REPO=security-lab
IMAGE_NAME=codemender-sandbox
IMAGE_TAG=latest

# Cloud Run Job
SANDBOX_JOB_NAME=codemender-sandbox
SANDBOX_SA_NAME=sandbox-runner-sa
SANDBOX_NETWORK=sandbox-vpc
SANDBOX_SUBNET=sandbox-subnet

# Inputs bucket (default: <GCP_PROJECT_ID>-sandbox-inputs)
SANDBOX_BUCKET=your-gcp-project-id-sandbox-inputs

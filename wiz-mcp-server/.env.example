# ============================================================================
# Wiz Security MCP Server configuration
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `.env` is git-ignored, so secrets in it are never committed.
# - Local runs: config.py reads `.env` automatically.
# - Cloud Run: deploy_cloud_run.sh reads `.env` and passes the values to the
#   `wiz-mcp-server` service. WIZ_CLIENT_SECRET is stored in Secret Manager,
#   never as a plain environment variable.
# ============================================================================

# --- Google Cloud ------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
REGION=us-central1
SERVICE_NAME=wiz-mcp-server

# --- Wiz ---------------------------------------------------------------------
# Create a Wiz service account (Settings > Service Accounts) with read-only
# permissions: `read:issues`, `read:vulnerabilities`, `read:security_graph`,
# `read:resources`.
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
# Your tenant's API endpoint (Wiz portal > User Settings > Tenant Info).
WIZ_API_ENDPOINT=https://api.us17.app.wiz.io/graphql
# Defaults; change only if your tenant uses a different auth endpoint.
WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
WIZ_AUDIENCE=wiz-api
# Secret Manager secret name used by deploy_cloud_run.sh for WIZ_CLIENT_SECRET.
WIZ_SECRET_NAME=wiz-client-secret
# Optional: comma-separated regions for user-managed secret replication (e.g. us-central1).
# Leave empty to use automatic (global) replication, with a fallback to REGION if the
# org's resource-location policy blocks global.
WIZ_SECRET_LOCATIONS=

# --- Org policy ---------------------------------------------------------------
# Before creating resources, deploy_cloud_run.sh sets a project-level
# constraints/gcp.resourceLocations policy that inherits the org's allowed locations
# and adds ORG_POLICY_ALLOWED_LOCATIONS. Needs roles/orgpolicy.policyAdmin on the org
# or folder. Set OPEN_ORG_POLICY=false to skip.
OPEN_ORG_POLICY=true
# Default when empty: "global in:<REGION>-locations"
ORG_POLICY_ALLOWED_LOCATIONS=

# Copy to .env for local runs. Placeholders only; never commit real values.
GCP_PROJECT_ID=your-gcp-project-id
REGION=us-central1

SECURITY_DATASET=security_lab
SECURITY_EVENTS_TABLE=security_events
SANDBOX_RUNS_TABLE=sandbox_runs
INGESTION_ERRORS_TABLE=ingestion_errors
BQ_DATASET=codemender
BQ_TABLE=findings

# In-app OIDC check of the Pub/Sub push token. Leave empty to skip it
# (Cloud Run IAM still requires an authenticated invoker).
# Set to the audience configured on the push subscription, usually the service URL:
# PUSH_AUDIENCE=https://security-log-ingestion-REPLACE_ME-uc.a.run.app/pubsub/push
PUSH_AUDIENCE=
# Optional: require the token's email claim to be this service account.
# PUSH_SERVICE_ACCOUNT=pubsub-push-sa@your-gcp-project-id.iam.gserviceaccount.com
PUSH_SERVICE_ACCOUNT=

PORT=8080

# ============================================================================
# Code Mender MCP Server configuration
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `.env` is git-ignored, so secrets in it are never committed.
# - Local runs: config.py reads `.env` automatically.
# - Cloud Run: deploy_cloud_run.sh reads `.env` and passes the values to the
#   service. WIZ_CLIENT_SECRET is stored in Secret Manager, not as a plain
#   environment variable.
# ============================================================================

# --- Google Cloud ------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
REGION=us-central1
SERVICE_NAME=codemender-mcp-server

# --- BigQuery (Code Mender findings) ----------------------------------------
BQ_DATASET=codemender
BQ_TABLE=findings

# --- Cloud Logging ------------------------------------------------------------
LOG_NAME_FILTER=codemender

# --- Code Mender Execution Runner (Cloud Run Job & Git Auto-Fix) -------------
# Name of the Cloud Run Job that executes `cm-runner find-full / verify / fix`
CM_RUNNER_JOB_NAME=codemender-runner
# GCS bucket for transit snapshots and SARIF outputs (default: codemender-reports-<project>)
CM_REPORTS_BUCKET=
# Default patch mode: "pr" (open GitHub PR), "branch" (push branch only), or "none" (BigQuery only)
CM_DEFAULT_PATCH_MODE=pr
# GitHub Personal Access Token (classic with `repo` scope or fine-grained with Contents & Pull Requests write)
GITHUB_TOKEN=
# GitHub API URL (defaults to public GitHub)
GITHUB_API_URL=https://api.github.com
# Git commit author details for auto-fix branches and PRs
GIT_AUTHOR_NAME=CodeMender
GIT_AUTHOR_EMAIL=codemender-bot@users.noreply.github.com

# --- Wiz ---------------------------------------------------------------------
# Create a Wiz service account (Settings > Service Accounts) with the
# `read:issues` permission. Leave these empty to run without Wiz.
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
# Your tenant's API endpoint (Wiz portal > User Settings > Tenant Info).
WIZ_API_ENDPOINT=https://api.us17.app.wiz.io/graphql
# Defaults; change only if your tenant uses a different auth endpoint.
WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
WIZ_AUDIENCE=wiz-api
# Secret Manager secret name used by deploy_cloud_run.sh for WIZ_CLIENT_SECRET.
WIZ_SECRET_NAME=wiz-client-secret

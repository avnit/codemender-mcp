# Copy to agent/.env and fill in. Placeholders are treated as "not set".
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
AGENT_MODEL=gemini-2.5-flash

# Toggles (default true). A toolset with missing config is skipped with a warning.
ENABLE_WIZ=true
ENABLE_LOGGING=true
ENABLE_GITHUB=true
ENABLE_CODEMENDER=true

# Wiz remote MCP. Use WIZ_MCP_TOKEN, or WIZ_CLIENT_ID + WIZ_CLIENT_SECRET
# (client-credentials exchange against https://auth.app.wiz.io/oauth/token,
# audience wiz-api; confirm in your environment).
WIZ_MCP_URL=https://mcp.app.wiz.io
WIZ_CLIENT_ID=your-wiz-client-id
WIZ_CLIENT_SECRET=REPLACE_ME
# WIZ_MCP_TOKEN=REPLACE_ME

# Cloud Logging remote MCP (uses Application Default Credentials).
CLOUD_LOGGING_MCP_URL=https://logging.googleapis.com/mcp

# GitHub remote MCP (fine-grained PAT scoped to the payment-service repo).
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_PAT=ghp_REPLACE_ME
GITHUB_ORG=your-github-org
GITHUB_DEFAULT_BRANCHES=main,master

# Custom CodeMender MCP server on Cloud Run (Google ID token, audience = base URL).
CODEMENDER_MCP_URL=https://codemender-mcp-server-XXXX.us-central1.run.app/mcp

# Agent Engine staging bucket (deploy.py).
STAGING_BUCKET=gs://your-gcp-project-id-agent-staging

# Human-in-the-loop mode: native (ADK ToolConfirmation) or chat (reply "confirm").
HITL_MODE=native
# Also expose skills through ADK's experimental SkillToolset.
USE_ADK_SKILL_TOOLSET=false
